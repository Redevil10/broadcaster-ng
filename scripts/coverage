#!/bin/sh -e

export PREFIX=""
if [ -d 'venv' ] ; then
    export PREFIX="venv/bin/"
fi

set -x

${PREFIX}coverage report

# On GitHub Actions, also show the table on the run's summary page.
if [ -n "$GITHUB_STEP_SUMMARY" ]; then
    {
        echo "### Coverage"
        ${PREFIX}coverage report --format=markdown
    } >> "$GITHUB_STEP_SUMMARY"
fi
